<h1 class="text-2xl font-bold mb-4">Lista de Tareas</h1>

<%= link_to "Nueva tarea", new_task_path, class: "inline-block px-3 py-1 rounded bg-blue-600 text-white" %>

<table class="w-full mt-4">
  <thead>
    <tr>
      <th>Título</th>
      <th>Estimación (min)</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr class="border-t">
        <td><%= link_to task.title, task_path(task) %></td>
        <td><%= task.estimated_minutes || "—" %></td>
        <td><%= task.completed? ? "Completada" : "Pendiente" %></td>
        <td class="flex gap-2">
          <%= link_to "Editar", edit_task_path(task), class: "px-2 py-1 rounded bg-yellow-400 hover:bg-yellow-500 text-white" %>

          <%= button_to task_path(task),
                        method: :delete,
                        form: { "onsubmit" => "return confirm('¿Seguro que deseas eliminar esta tarea?');" },
                        class: "px-2 py-1 rounded bg-red-600 hover:bg-red-700 text-white" do %>
            Eliminar
          <% end %>

          <%= button_to (task.completed? ? "Marcar como pendiente" : "Marcar completada"),
                        toggle_complete_task_path(task),
                        method: :patch,
                        class: "px-2 py-1 rounded bg-green-600 hover:bg-green-700 text-white" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
