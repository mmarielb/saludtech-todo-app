<h1 class="mb-4">Lista de Tareas</h1>

<%= link_to "Nueva tarea", new_task_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Título</th>
      <th>Estimación (min)</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.title, task_path(task) %></td>
        <td><%= task.estimated_minutes || "—" %></td>
        <td><%= task.completed? ? "Completada" : "Pendiente" %></td>
        <td>
          <%= link_to "Editar", edit_task_path(task), class: "btn btn-sm btn-warning me-1" %>
          <%= link_to "Eliminar", task_path(task), method: :delete, data: { confirm: "¿Seguro que deseas eliminar esta tarea?" }, class: "btn btn-sm btn-danger me-1" %>
          <%= button_to (task.completed? ? "Marcar como pendiente" : "Marcar completada"),
                        toggle_complete_task_path(task), method: :patch, class: "btn btn-sm btn-success" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

