<h1 class="mb-4">Lista de Tareas</h1>

<%= link_to "Nueva tarea", new_task_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped table-hover shadow-sm">
  <thead>
    <tr>
      <th>Título</th>
      <th>Estimación (min)</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.title, task_path(task) %></td>
        <td><%= task.estimated_minutes %> min</td>
        <td><%= task.completed? ? "Completada" : "Pendiente" %></td>
        <td>
          <div class="d-flex gap-2">
            <%= link_to "Editar", edit_task_path(task), class: "btn btn-editar me-2" %>
            <%= button_to "Eliminar", task_path(task), method: :delete, data: { confirm: "¿Seguro que deseas eliminar esta tarea?" }, class: "btn btn-eliminar me-2" %>
            <%= button_to "Marcar completada", toggle_complete_task_path(task), method: :patch, class: "btn btn-completar" %>

          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

