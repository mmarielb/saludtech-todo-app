<!-- Muestra todas las tareas con acciones de editar, eliminar y alternar completada. GET /tasks -->
<h1 class="text-2xl font-bold mb-4">Lista de Tareas</h1>

<%= link_to "Nueva tarea", new_task_path, class: "inline-block px-3 py-1 rounded bg-blue-600 text-white" %>

<table class="w-full mt-4">
  <thead>
    <tr>
      <th>Título</th>
      <th>Estimación (min)</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr class="border-t">
        <td><%= link_to task.title, task_path(task) %></td>
        <td><%= task.estimated_minutes || "—" %></td>
        <td><%= task.completed? ? "Completada" : "Pendiente" %></td>
        <td>
          <%= link_to "Editar", edit_task_path(task), class: "mr-2" %>
          <%= link_to "Eliminar", task_path(task), method: :delete, data: { confirm: "¿Eliminar?" }, class: "mr-2" %>
          <%= button_to (task.completed? ? "Marcar como pendiente" : "Marcar completada"),
                        toggle_complete_task_path(task), method: :patch %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
