<!-- muestra toda la información de una tarea específica. GET /tasks/:id -->
<h1 class="mb-4">Detalles de la Tarea</h1>

<div class="card p-4 shadow-sm">
  <p><strong>Título:</strong> <%= @task.title %></p>
  <p><strong>Estimación:</strong> <%= @task.estimated_minutes %> min</p>
  <p><strong>Estado:</strong> <%= @task.completed? ? "Completada" : "Pendiente" %></p>
</div>

<div class="mt-3">
  <%= link_to "Editar", edit_task_path(@task), class: "btn btn-warning me-2" %>
  <%= link_to "Volver", tasks_path, class: "btn btn-secondary" %>
</div>

