{
  "name": "app",
  "private": true,
  "devDependencies": {
    "autoprefixer": "^10.0.0",
    "esbuild": "^0.18.18",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.1.12"
  },
  "scripts": {
    "build:js": "esbuild app/javascript/application.js --bundle --sourcemap --outdir=app/assets/builds",
    "build:css": "tailwindcss -i ./app/assets/tailwind/application.css -o ./app/assets/builds/application.css --minify",
    "build": "yarn build:js && yarn build:css"
  },
  "dependencies": {
    "@rails/ujs": "^7.1.3-4"
  }
}
